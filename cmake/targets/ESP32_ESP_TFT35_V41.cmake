if(ESP32_ESP_TFT35_V41)
    if(NOT CAMERA_SERVICE)
        list(APPEND EXCLUDE_COMPONENTS camera)
    endif()
    set(TFT_TARGET "ESP32_ESP_TFT35_V41")
    set(SDKCONFIG "${CMAKE_BINARY_DIR}/sdkconfig")
    set(SDKCONFIG_DEFAULTS "${CMAKE_SOURCE_DIR}/hardware/ESP32_ESP_TFT35_V41/sdkconfig.defaults")
    list(APPEND EXTRA_COMPONENT_DIRS ${CMAKE_SOURCE_DIR}/hardware/ESP32_ESP_TFT35_V41/components)
    add_compile_options("-I${CMAKE_SOURCE_DIR}/hardware/ESP32_ESP_TFT35_V41/components/bsp")
    set(RESOLUTION_SCREEN "res_320_480")
    # Enables brightness, display flip and touch inversion from the pendant UI.
    add_compile_options("-DPENDANT_BSP_CONTROLS=1")
    if(SD_CARD_SERVICE)
        message(FATAL_ERROR "ESP-TFT35 v4.1 has no verified SD wiring; set SD_CARD_SERVICE=OFF")
    endif()
endif()
